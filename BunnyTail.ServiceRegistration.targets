<Project>

  <ItemGroup>
    <CompilerVisibleProperty Include="ServiceRegistrationResolveReferencedAssembly" />
    <CompilerVisibleProperty Include="_ServiceRegistrationIgnoreInterface" />
  </ItemGroup>

  <Target Name="ComputeServiceRegistrationIgnoreInterface"
          BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun">
    <PropertyGroup>
      <_ServiceRegistrationIgnoreInterface>$(ServiceRegistrationIgnoreInterface.Replace('%', '%2525').Replace('#', '%2523').Replace(';', '%253B').Replace('%0D', '%250D').Replace('%0A', '%250A'))</_ServiceRegistrationIgnoreInterface>
    </PropertyGroup>
  </Target>

</Project>
